    "for k in [\"000520\", \"001000\", \"001480\", \"002400\", \"003320\"]:\n",
    "    im = Image.open(f\"fakes{k}.png\").convert(\"RGB\")\n",
    "    im = im.resize((im.width // 2, im.height // 2), Image.LANCZOS)\n",
    "    im.save(f\"fakes{k}_half.jpg\", quality=85)"
